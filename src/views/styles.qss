QMainWindow, QDialog {
    background-color: #94A3B8;
    color: #1E293B;
    font-family: 'Segoe UI', sans-serif;
    font-size: 12px;
}
QLabel {
    color: #1E293B;
}
QWidget#top_panel, QWidget#left_panel, QWidget#right_panel, QWidget#bottom_panel {
    background-color: #64748B;
    border-radius: 4px;
}
QWidget#top_panel QLabel, QWidget#left_panel QLabel, QWidget#right_panel QLabel, QWidget#bottom_panel QLabel {
    color: #F8FAFC;
}
QLineEdit, QTextEdit {
    background-color: #94A3B8;
    color: #0F172A;
    border: 1px solid #475569;
    border-radius: 4px;
    padding: 5px;
}
QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #6366F1;
    background-color: #F8FAFC;
}
QGraphicsView {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
}
QListWidget, QTableView {
    background-color: #475569;
    color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 4px;
}
QTableView {
    background-color: #F8FAFC;
    color: #0F172A;
}
QPushButton {
    background-color: #6366F1;
    color: #FFFFFF;
    font-weight: bold;
    border: none;
    border-radius: 4px;
    padding: 6px 14px;
}
QPushButton:hover {
    background-color: #4F46E5;
}
QPushButton#accent_btn {
    background-color: #00FFFF;
    color: #0F172A;
}
QPushButton#destructive_btn {
    background-color: #EF4444;
}
QPushButton[flat="true"] {
    background-color: transparent;
    color: #4F46E5;
    text-decoration: underline;
}
QCheckBox {
    color: #F8FAFC;
}
QSplitter::handle {
    background-color: transparent;
}
